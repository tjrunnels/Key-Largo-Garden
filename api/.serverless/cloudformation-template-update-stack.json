    "GraphQlSchema": {
      "Type": "AWS::AppSync::GraphQLSchema",
      "Properties": {
        "Definition": "schema {\n  query: Query\n}\n\ntype Query {\n  getUpdate(updateID: String!): Update\n  getUpdates(nextToken: String): UpdatesPage\n  getPlant(plantID: String!): Plant\n  getPlants(nextToken: String): PlantsPage\n  getPlantsByPost(postID: String!): PlantsPage\n  getPost(postID: String!): Post\n  getPosts(nextToken: String): PostsPage\n  getPostsByPlant(plantID: String!, limit: Int, nextToken: String!): PostsPage\n}\n\ntype UpdatesPage {\n  updates: [Update]\n  nextToken: String\n  hasMore: Boolean\n}\n\ntype Update @model @key(fields: [\"updateID\"]) {\n  updateID: ID!\n  postID: ID\n  plantID: ID\n  updateType: [UpdateType]!\n}\n\nenum UpdateType {\n  POST_CREATED\n  PICTURE_ADDED\n  PLANT_ADDED\n  PLANT_REMOVED\n}\n\ntype PlantsPage {\n  plants: [Plant]\n  nextToken: String\n  hasMore: Boolean\n}\n\ntype Plant @model @key(fields: [\"plantID\"]) {\n  plantID: ID!\n  linkedIn: [PostsPage]\n  name: String!\n  description: String\n  pictures: [String]\n  createdAt: AWSDateTime!\n  updatedAt: AWSDateTime!\n}\n\ntype PostsPage {\n  posts: [Post]\n  nextToken: String\n  hasMore: Boolean\n}\n\ntype Post @model @key(fields: [\"postID\"]) {\n  postID: ID!\n  linkedPlants: [Plant]\n  title: String!\n  content: String!\n  pictures: [String]\n  createdAt: AWSDateTime!\n  updatedAt: AWSDateTime!\n}",
        "ApiId": {
          "Fn::GetAtt": [
            "GraphQlApi",
            "ApiId"
          ]
        }
      }
    },
